{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  },
  "redirects": [
    {
      "source": "/services/ai-integration",
      "destination": "/ai-integration/",
      "permanent": true
    },
    {
      "source": "/services/ai-integration/",
      "destination": "/ai-integration/",
      "permanent": true
    },
    {
      "source": "/services/payment-integrations",
      "destination": "/payment-integrations/",
      "permanent": true
    },
    {
      "source": "/services/payment-integrations/",
      "destination": "/payment-integrations/",
      "permanent": true
    },
    {
      "source": "/services/wordpress-development",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/wordpress-development/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/web-applications",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/web-applications/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/product-launch",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/product-launch/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/seo-growth",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/seo-growth/",
      "destination": "/services/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
